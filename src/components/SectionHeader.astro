---
interface Props {
  eyebrow: string;
  title: string;
  body?: string;
  tone?: "light" | "dark";
}

const { eyebrow, title, body, tone = "dark" } = Astro.props;
---
<header class:list={["section-header", `section-header--${tone}`]}>
  <p class="eyebrow">{eyebrow}</p>
  <h2>{title}</h2>
  {body && <p class="section-header__body">{body}</p>}
</header>
